class Animal:
    def __init__(self,name):
        self.name=name

    def speak(self,sound):
            self.sounds=sound
            return self.sounds

class Dog(Animal):
    def __init__(self,name):
        self.name=name
        self.speak("Guau")


class Cat(Animal):

    def __init__(self,name):
        self.name=name
        self.speak("Miau")


            

animal=Animal("Animal")
print(animal.speak("Makes a sound"))

dog=Dog("Firulais")
print(dog.speak())

cat=Cat("Michi")
print(cat.speak())