class Saludo:

    def __init__(self,name):
        self.name=name

    def repeat_twice(func):
        def wrapper(self):
            func(self)
            func(self)
        return wrapper

    @repeat_twice
    def printing(self):
        print("Hola,",self.name)


saludo1=Saludo("Ale")
saludo1.printing()

saludo2=Saludo("Saul")
saludo2.printing()
