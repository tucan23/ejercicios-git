class Punto:

    def __init__(self):
        self.x=int(input("ingrese la coordenada x:"))
        self.y=int(input("ingrese la coordenada y:"))

    def imprimir(self):
        print("coordenadas del punto: x:", self.x, "y:", self.y)

    def localizar(self):
        if self.x>0 and self.y>0:
            print("se encuentra en el I cuadrante")
        elif self.x<0 and self.y>0:
            print("se encuentra en el II cuadrante")
        elif self.x<0 and self.y<0:
            print("se encuentra en el III cuadrante")
        elif self.x>0 and self.y<0:
            print("se encuentra en el IIV cuadrante")


#bloque principal
punto1=Punto()
punto1.imprimir()
punto1.localizar()
