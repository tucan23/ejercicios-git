class Client:
    suspended_clients=[]

    def enter(self,name,code):
        self.name=name
        self.code=code

    def printing(self):
        print("name:",self.name, "code:", self.code)
        self.suspended()
    
    def suspended(self):
        if self.code in Client.suspended_clients:
            print("This client is suspended")
            input("press enter to continue")
        else:
            print("This client is ok")
            input("press enter to continue")
    
    def suspend(self):
        Client.suspended_clients.append(self.code)

