class Alumno:

    def inicializar(self,nombre,nota):
        self.nombre=nombre
        self.nota=nota

    def imprimir(self):
        print("Nombre",self.nombre)
        print("Nota",self.nota)
    
    def estado(self):
        if 4<=self.nota:
            print("Regular")
        else:
            print("Libre")


#bloque principal
alumno1=Alumno()
alumno1.inicializar("Saul", 9)
alumno1.imprimir()
alumno1.estado()

alumno2=Alumno()
alumno2.inicializar("Ana", 10)
alumno2.imprimir()
alumno2.estado()



