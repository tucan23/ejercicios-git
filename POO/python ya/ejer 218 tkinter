import tkinter as tk
import sys

class App:

    def __init__(self):
        self.window1=tk.Tk()
        self.window1.title("Tryout window")
        

        self.button1=tk.Button(self.window1, text="women button", command=self.women, foreground="pink")
        self.button1.grid(column=0, row=0)
        
        self.button2=tk.Button(self.window1, text="men button", command=self.men, foreground="blue")
        self.button2.grid(column=0, row=1)
        
        self.button3=tk.Button(self.window1,text="end", command=self.end, foreground="green")
        self.button3.grid(column=0, row=2)

        self.window1.mainloop()

    def women(self):
        self.window1.title("women window")

    def men(self):
        self.window1.title("men window")   
    
    def end(self):
        sys.exit(0)

app1=App()