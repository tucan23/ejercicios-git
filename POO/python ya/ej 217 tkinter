import tkinter as tk
import sys

class App:

    def __init__(self):
        self.window1=tk.Tk()
        self.window1.title("T-REX DEVS")
        
        self.label1=tk.Label(self.window1, text="Billing System")
        self.label1.grid(column=0, row=0)
        
        self.label2=tk.Label(self.window1, text="2018")
        self.label2.grid(column=0, row=1)
        
        self.button1=tk.Button(self.window1,text="end", command=self.finalizar)
        self.button1.grid(column=0, row=2)

        self.window1.resizable(False,False)
        self.window1.mainloop()

    def finalizar(self):
        sys.exit(0)

app1=App()

    